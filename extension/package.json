{
  "name": "chrome-extension-react",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && ALLOW_LOCAL_EXTENSION_BUILD=true vite build --mode development",
    "lint": "eslint .",
    "test:usage-sync": "node scripts/test-usage-sync.mjs",
    "preview": "vite preview",
    "zip": "pnpm build && rm -f extension.zip && cd build && zip -r ../extension.zip . -x '*.map' '*.DS_Store' '__MACOSX/*' '.vite/*' '.vite/'",
    "test:content-timer": "node scripts/test-content-timer.mjs",
    "test:usage-day-reset": "node scripts/test-usage-day-reset.mjs",
    "test:timer-lifecycle": "node scripts/test-timer-lifecycle.mjs",
    "test:timer-startup": "node scripts/test-timer-startup.mjs",
    "test:timekeeping": "node --test scripts/test-usage-sync.mjs scripts/test-content-timer.mjs scripts/test-usage-day-reset.mjs scripts/test-timer-lifecycle.mjs scripts/test-timer-startup.mjs scripts/test-counter-interleavings.mjs scripts/test-limit-settings.mjs scripts/test-rule-form.mjs",
    "test:counter-interleavings": "node scripts/test-counter-interleavings.mjs",
    "test:limit-settings": "node --test scripts/test-limit-settings.mjs scripts/test-rule-form.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/vite": "^4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "11.10.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.23.26",
    "openai": "^6.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@eslint/js": "^9.25.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "24.0.13",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.5",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "6.0.5",
    "vite-plugin-static-copy": "2.3.0"
  }
}
