rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usageCounters/{uid}/days/{dayKey}/values/{counterId} {
      function isCounterOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isValidCounter() {
        let data = request.resource.data;
        return data.keys().hasAll(['seconds', 'kind', 'siteKey', 'installationId'])
          && data.keys().hasOnly(['seconds', 'kind', 'siteKey', 'installationId'])
          && data.seconds is int
          && data.seconds >= 0
          && data.seconds <= 9007199254740991
          && data.kind in ['legacy', 'installation', 'site', 'total']
          && data.siteKey is string
          && data.installationId is string
          && ((data.kind == 'total' && data.siteKey == '' && data.installationId == '')
            || (data.kind in ['legacy', 'site'] && data.siteKey.size() > 0
              && data.siteKey.size() <= 253 && data.installationId == '')
            || (data.kind == 'installation' && data.siteKey.size() > 0
              && data.siteKey.size() <= 253 && data.installationId.size() > 0
              && data.installationId.size() <= 128));
      }

      allow read: if isCounterOwner();
      allow create: if isCounterOwner() && isValidCounter();
      allow update: if isCounterOwner() && isValidCounter()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seconds'])
        && request.resource.data.seconds >= resource.data.seconds;
      allow delete: if false;
    }

    // Keep existing reads and unrelated collections unchanged during the
    // usage-counter migration. User-root writes need the narrower rule below.
    match /{collection}/{document=**} {
      allow read: if collection != 'usageCounters';
      allow write: if collection != 'users' && collection != 'usageCounters';
    }

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function protectedUsageFields() {
        return ['dailyUsageHistory', 'usageResetRequestedAt', 'usageResetAppliedAt', 'usageCountersVersion'];
      }

      allow create: if isOwner()
        && !request.resource.data.keys().hasAny(protectedUsageFields());
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUsageFields());
      // Deleting the user document would erase the protected history mirror.
      allow delete: if false;
    }

    // The minimum subcollection/document pair prevents this rule from also
    // matching users/{uid}, which would bypass the root counter protection.
    match /users/{uid}/{subcollection}/{documentId}/{nested=**} {
      allow read, write: if true;
    }
  }
}
